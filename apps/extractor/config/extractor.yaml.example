# extractor 設定の例。apps/extractor/config/extractor.yaml にコピーして実値を入れる(.gitignore 済み)。
# リポジトリ名はここから読む(コードにハードコードしない・CLAUDE.md §12.2)。
minutes:
  repo: org/minutes # 出典に使う "org/name"
  dir: minutes # CLONES_DIR 配下の clone ディレクトリ名
  # exclude: [transcript.md]   # 抽出対象から外す basename(既定 transcript.md。生書き起こしは重く冗長)
  # url: https://github.com/org/minutes.git   # private は認証付き。省略時は checkout 済みの dir を使う
kb:
  repo: org/knowledge-base
  dir: knowledge-base
  # url: https://github.com/org/knowledge-base.git
# interviews は KB リポ内のディレクトリ(§6.6 ⑤-b・PR-I1)。省略時は下記の既定で動く。
# interviews:
#   dir: interviews
#   exclude_dirs: [kits, voice-memos]   # 質問リストと voice-memo 原本は抽出対象外
base_branch: main
# 参加者行から除外する非人物名(録音 bot 等・ADR-0027 D1)。省略時は下記の既定。
# participants_exclude: [QB, Recorder]
# 抽出 PR 通知でレビュー担当としてメンションする Discord ユーザ ID(日替わり交代)。
# 試用運用: レビューをお願いする 2 名の ID を入れる。空(既定)ならメンション無し。
# review_mentions: ["111111111111111111", "222222222222222222"]
# 抽出 PR が作成から N 日以上 open のままなら、見送り通知で全員をメンション(既定 2)。
# review_escalate_after_days: 2
