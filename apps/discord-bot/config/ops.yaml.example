# 👍 代理マージ(§6.3 / C1 拡張)の設定例。ops.yaml にコピーして実値を入れる(.gitignore 済み)。
# 両方を設定して初めて有効になる(未設定=機能 OFF)。GitHub 認証(GITHUB_TOKEN か App trio)も必要。
channel_id: "123456789012345678" # extractor が PR 通知を投稿する #stratum-ops のチャンネル ID
kb_repo: org/knowledge-base # マージを許可する唯一のリポ(他リポの PR URL は拒否)

# /ask を使えるメンバーのロール ID(ADR-0036 D7)。いずれか 1 つを持っていれば使える。
# 検索対象に private リポが入るため社内のチームロールに限定する。未設定(空)なら全員が使える。
# ロール ID は Discord の「サーバー設定 → ロール」でロールを右クリック →「ID をコピー」。
ask_role_ids:
  - "123456789012345678" # 例: Team A
  - "234567890123456789" # 例: Team B

# bot が利用者に応える「ホーム」チャンネル(2026-10-07)。/ask はここ(とその中のスレッド)だけで受け付け、
# 頼まれていない案内の公開返信もここ以外では出さない。運用では #knowledge_sharing を入れる。
# 未設定(空)なら従来どおり全チャンネル。💡・音声メモ・DM・面談パネル・ops 通知には影響しない。
home_channel_ids:
  - "123456789012345678" # 例: #knowledge_sharing
