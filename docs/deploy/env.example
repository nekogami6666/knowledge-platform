# stratum bot secrets — Claude on AWS + Discord(ADR-0009 / ADR-0010 §9.1)。
# deploy.sh が初回にこれを ~/stratum/stratum.env へコピーします(chmod 600)。
# 値はクォート不要。= の後にそのまま貼る。REPLACE_ME を実値に置き換えること。
# このファイル(.example)に本物のシークレットを書かないこと(コミットされます)。

# Claude on AWS(全 AI 操作はこの 4 変数で動く・ADR-0009)
CLAUDE_CODE_USE_ANTHROPIC_AWS=1
# ワークスペース API キー: AEAA… で始まる ~131 字。ドット無し。
#   ※ MT… で始まりドット2個・~72字なら Discord トークンの取り違えです。
ANTHROPIC_AWS_API_KEY=REPLACE_ME_aws_workspace_key
ANTHROPIC_AWS_WORKSPACE_ID=REPLACE_ME_wrkspc_id
AWS_REGION=ap-northeast-1

# Discord
DISCORD_TOKEN=REPLACE_ME_discord_bot_token
# スラッシュコマンド登録先サーバー(ギルド)ID。未指定だとグローバル登録(反映に最大1時間)。
DISCORD_GUILD_ID=REPLACE_ME_guild_id

# --- 任意(機能単位で有効化) ---

# GitHub 書き込み(👍 代理マージ / 💡 capture / voice-memo の PR + gap-tracker/freshness の
# question commit・KB PR)。GitHub App trio(推奨・組織所有)か GITHUB_TOKEN(PAT)のどちらか。
# ★本番は App 推奨(Actions と同じ値・ADR-0013 D4 の hybrid: PR/write=App / clone=PAT)。
# GITHUB_APP_ID=REPLACE_ME_app_id
# GITHUB_APP_PRIVATE_KEY=REPLACE_ME_pem_full_or_\n_embedded
# GITHUB_APP_INSTALLATION_ID=REPLACE_ME_installation_id
# または PAT(暫定): GITHUB_TOKEN=REPLACE_ME_fine_grained_pat

# voice-memo の文字起こし(ADR-0015 D3)。未設定なら voice-memo は受付のみ(文字起こしされない)。
# knowledge-platform 専用に新規発行(QB-Meeting-Ops と分離)。
# OPENAI_API_KEY=REPLACE_ME_openai_key

# VC 録音入口(ADR-0020)。RECORDER_URL は compose 内部ネットワーク。RECORDER_DISCORD_TOKEN は
# 録音専用 bot(メイン bot とは別の新規 App・ADR-0020 D2)。両方揃えて `--profile vc` で有効。
# RECORDER_URL=http://recorder:9488
# RECORDER_DISCORD_TOKEN=REPLACE_ME_recorder_bot_token
# 録音の保持期限(stratum-recordings-cleanup.timer・毎日 04:30 JST)。unit 既定は 14 日 / tmp 3 日。
# 変更したいときだけ設定する(原本の文字起こしは KB にあるので音声は短命でよい・ADR-0020)。
# RECORDINGS_RETENTION_DAYS=14
# RECORDINGS_TMP_RETENTION_DAYS=3

# --- gap-tracker / freshness-checker(systemd)も同じ stratum.env を EnvironmentFile で共用 ---
# gap-tracker の回答依頼を投稿する Discord webhook(§6.5)。real 稼働に必須。
# DISCORD_GAP_WEBHOOK=REPLACE_ME_gap_channel_webhook
# extractor/gap/freshness の #stratum-ops 通知先(任意だが本番推奨)。
# DISCORD_OPS_WEBHOOK=REPLACE_ME_ops_channel_webhook
# ※ GAP_TRACKER_REAL / FRESHNESS_REAL はここではなく install-timers.sh --real で unit 側に立てる。

# --- git clone 認証(㉞ セキュリティ修正) ---
# repos.yaml / gap.yaml / freshness.yaml の url にはトークンを書かず、ここに置く
# (bot・gap-tracker・freshness-checker が実行時に URL へ注入する。/config はエージェント可視のため)。
# 実運用(2026-09-30 時点)は org を見られるオーナーの GitHub OAuth トークン(gho_・scope repo 等)。
# 最小構成なら repos.yaml の各リポに Contents: Read の fine-grained PAT でもよい。
# ⚠️ repos.yaml の all_visible(ADR-0036)を有効にすると、**このトークンで見える org のリポ全部**
# (アーカイブ・フォーク・exclude を除く)が /ask の検索範囲になる。範囲はトークンの持ち主の可視範囲で
# 決まるため、機密リポは exclude に足すかトークンの持ち主から見えないようにする。
# all_visible の列挙(GET /orgs/{org}/repos)にもこのトークンを使う(未設定なら列挙せず手動指定のみ)。
# GIT_CLONE_TOKEN=REPLACE_ME

# --- all_visible の定期同期(bot・ADR-0036 D5)---
# 範囲の再列挙・全対象リポの clone/fetch・対象外 clone の削除の間隔 ms(既定 600000 = 10 分)。
# 起動直後(ClientReady)に 1 回、以後この間隔で /ask と同じ直列キューに 2 リポずつ低優先度で積む
# (待機中のチャンクは /ask に追い越される・ADR-0035 追記 2026-10-08)。
# repos.yaml に all_visible が無ければ使われない(定期同期そのものが無効)。
# REPO_SYNC_INTERVAL_MS=600000

# --- /ask の時間予算(bot・ADR-0035)---
# agentic search の上限 ms(既定 600000 = 10 分)。実測: 2026-09 は 120 秒既定で timeout が 4 割。
# ASK_TIMEOUT_MS=600000
# 探索量の実験ノブ(ADR-0035 D6)。未設定 = 現状維持(maxTurns 30・effort/thinking は SDK 既定)。
# golden eval と queries.elapsed_ms で比較してから設定する。ASK_MAX_TURNS を下げると
# 上限到達時に汎用エラー文面になる点に注意。
# ASK_MAX_TURNS=30
# ASK_EFFORT=medium        # low | medium | high
# ASK_THINKING=adaptive    # adaptive | disabled
# 正常終了(docker stop の SIGTERM)で処理中の /ask を待つ上限 ms(既定 60000・ADR-0035 追記)。
# 超えたら検索を中断し「再起動のため中断しました」と通知する。docker-compose.yml の
# stop_grace_period(90s)から後処理の 15 秒を引いた値より小さくすること。
# SHUTDOWN_GRACE_MS=60000
# 同期の再利用(ADR-0035 追記・段階 1-2)。最終成功同期から ASK_SYNC_TTL_MS 以内の /ask は fetch しない
# (作業ツリーがクリーンで HEAD が記録 SHA と一致する場合だけ)。同期に失敗しても最終成功から
# ASK_SYNC_MAX_STALENESS_MS 以内なら前回データで検索し、回答末尾に「※ ナレッジは M/D HH:mm 時点の内容です」
# と明示する。超えた・未同期なら、repos.yaml の repos: のリポはエラー文面を返し、all_visible の列挙分は
# その /ask の対象から外す。再起動直後は clone の .git/FETCH_HEAD の時刻で最終成功を補う。
# 0 は不可(最小 1。再利用を実質止めたいときは 1)。
# ASK_SYNC_TTL_MS=60000
# ASK_SYNC_MAX_STALENESS_MS=21600000
# /ask の先回り同期(ADR-0035 追記 2026-10-08)。この間隔ごとに、直列キューが空のときだけ repos: のリポ
# (と all_visible の sync_on_ask 分)を低優先度で同期し、次の /ask が TTL 内の再利用に当たるようにする。
# ASK_SYNC_TTL_MS より短くすること。0 で無効(従来どおり /ask の中で同期する)。
# ASK_BACKGROUND_SYNC_MS=45000
# Claude Code subprocess の事前起動(ADR-0042・既定 off)。on にすると /ask の後に次の 1 回分を起動して待機させ、
# 起動待ち(startupMs)を外す。待機中は 1 本(約 230〜260 MB)多く持つ。完了ログの prewarmed / startupMs で効果を見る。
# ASK_PREWARM_IDLE_MS(既定 1800000 = 30 分)を超えて待機したら閉じる。戻すときは off にして再起動する。
# ASK_PREWARM=off
# ASK_PREWARM_IDLE_MS=1800000

# --- extractor Discord ソース(systemd・ADR-0033)も同じ stratum.env を共用 ---
# 新規シークレット不要(DISCORD_TOKEN / GIT_CLONE_TOKEN / Claude on AWS / DISCORD_OPS_WEBHOOK を流用)。
# 任意の調整変数(未設定なら既定値。REAL ゲートは install-timers.sh --real で unit 側に立てる):
# EXTRACTOR_DISCORD_TIMEOUT_MS=300000
# EXTRACTOR_DISCORD_RECONCILE_CONCURRENCY=4
