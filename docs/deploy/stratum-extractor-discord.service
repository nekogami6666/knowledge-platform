# systemd "user" service template for the stratum extractor Discord source (ADR-0033).
# Do NOT edit this file directly on the VM — install-timers.sh が __PLACEHOLDERS__ を描画して
# ~/.config/systemd/user/stratum-extractor-discord.service に配置する(README 参照)。
#
# bot と同じ VM で動く oneshot バッチ。DISCORD_TOKEN が stratum.env にのみ存在するため
# VM timer で実行する(Actions への token 複製は ADR-0017 D7 の却下を維持・ADR-0033 D1)。
# 短命の第 2 Gateway セッション(Guilds のみ・invisible)で履歴を収集し、抽出後は本文を破棄する(D6)。
[Unit]
Description=stratum extractor Discord source (channel history to KB PR)
Documentation=https://github.com/queeenb-com/knowledge-platform/blob/main/docs/deploy/README.md
After=network-online.target
# 失敗を #stratum-ops へ配達する(㉞ 調査 S1: exit 1 は記録されるだけで誰にも届かなかった)。
OnFailure=stratum-notify-failure@%n.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
# シークレット(DISCORD_TOKEN / GIT_CLONE_TOKEN / Claude on AWS / DISCORD_OPS_WEBHOOK)は
# chmod 600 の env ファイルから(§9.1)。新規シークレットは不要(全て stratum.env に既存)。
EnvironmentFile=__ENV_FILE__
# discord.yaml は extractor の config dir(targets 空 = 機能 OFF で安全に no-op)。
Environment=CONFIG_DIR=__REPO_DIR__/apps/extractor/config
# channels.yaml(permanent_exclude)は bot と共有(ADR-0018 の信頼境界を同一に保つ)。
Environment=CHANNELS_CONFIG_DIR=__REPO_DIR__/apps/discord-bot/config
# clone は app 専用ディレクトリ(bot / 他バッチと分離。共有すると git clean が staging を消す)。
Environment=CLONES_DIR=__DATA_DIR__/clones-extractor-discord
# 実 PR + state commit は明示 opt-in(初回は外して dry-run 検証)。
# Environment=EXTRACTOR_DISCORD_REAL=1
ExecStart=__NODE_BIN__ apps/extractor/dist/discord/index.js
SyslogIdentifier=stratum-extractor-discord
