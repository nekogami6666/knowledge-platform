# systemd "user" service template for the VC recording retention cleanup (ADR-0020 / ADR-0016 D2).
# Do NOT edit this file directly on the VM — install-timers.sh が __PLACEHOLDERS__ を描画して
# ~/.config/systemd/user/stratum-recordings-cleanup.service に配置する(README 参照)。
#
# sidecar は finalize 後も参加者ごとの生 PCM(tmp/・約 11.5MB/分/人)と recording.m4a を残す。
# recorder 再起動で finalize されなかった孤児も溜まるため、保持期限で掃除する(ADR-0020「音声は
# 保持期間後に削除してよい」)。bot.db の pending(処理待ち voice_memo)は年齢に関わらず保持する。
# 既定 dry-run。実削除は install-timers.sh --real で RECORDINGS_CLEANUP_REAL=1 が有効化される。
[Unit]
Description=stratum VC recording retention cleanup (delete aged recordings/PCM)
Documentation=https://github.com/queeenb-com/knowledge-platform/blob/main/docs/deploy/README.md
After=network-online.target
# 失敗を #stratum-ops へ配達する(㉞ 調査 S1: exit 1 は記録されるだけで誰にも届かなかった)。
OnFailure=stratum-notify-failure@%n.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__ENV_FILE__
# bot.db は共有(bot と同じ SQLite・WAL + busy_timeout)。pending 照合は read-only。
Environment=DB_PATH=__DATA_DIR__/data/bot.db
# ホスト側のパス(コンテナ内 /recordings と同じ実体)。rootless docker の uid0 = ホストユーザ(ADR-0016 D2)。
Environment=RECORDINGS_DIR=__DATA_DIR__/recordings
# 保持日数(env ファイルで上書き可)。tmp/ の生 PCM は容量が大きいので短め。
Environment=RECORDINGS_RETENTION_DAYS=14
Environment=RECORDINGS_TMP_RETENTION_DAYS=3
# 実削除 gate(既定は dry-run で「消す予定」をログ出力するだけ)。
# Environment=RECORDINGS_CLEANUP_REAL=1
ExecStart=__NODE_BIN__ apps/discord-bot/dist/recordings-cleanup-cli.js
SyslogIdentifier=stratum-recordings-cleanup
